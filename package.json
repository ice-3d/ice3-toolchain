{
  "name": "ice3-toolchain-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "imports": {
    "#test-expect": "./tests/assertions.ts",
    "#test-runner": "./tests/node-test.ts",
    "#test-mocks": "./tests/test-mocks.ts"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/run-tests.mjs",
    "test:architecture": "node scripts/run-tests.mjs tests/architecture",
    "verify": "npm run test:architecture && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "expect": "30.5.2",
    "jest-mock": "30.5.2",
    "typescript": "7.0.2",
    "tsx": "4.23.15"
  }
}
