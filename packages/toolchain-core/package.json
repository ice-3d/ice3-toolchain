{
  "name": "@ice3/toolchain-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map"
